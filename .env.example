# Lazarus Protocol — Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to git.

# Security: API Key (REQUIRED for web server)
# Generate a secure API key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LAZARUS_API_KEY=your_secure_api_key_here_minimum_32_characters

# Alert: Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
ALERT_FROM_EMAIL=lazarus@yourdomain.com
ALERT_TO_EMAIL=your_personal_email@gmail.com

# Alert: Telegram (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# IPFS (optional — falls back to local if not set)
IPFS_API_URL=http://127.0.0.1:5001
PINATA_API_KEY=your_pinata_key
PINATA_SECRET_KEY=your_pinata_secret

# Vault config
VAULT_PATH=~/.lazarus/vault.json
CHECKIN_INTERVAL_DAYS=30
# envsitter: Enable Ledger hardware wallet support (true/false)
LEDGER_ENABLED=false
# envsitter: Enable Trezor hardware wallet support (true/false)
TREZOR_ENABLED=false
# envsitter: Web3.Storage API token for decentralized file storage
WEB3_STORAGE_TOKEN=
# envsitter: Ethereum network (mainnet, sepolia, goerli, polygon, arbitrum)
ETH_NETWORK=mainnet
# envsitter: Custom Ethereum RPC endpoint (optional, uses default per network)
ETH_RPC_ENDPOINT=
