# Staging Environment Configuration
# Copy this file to .env.staging and update with your staging values

# Application
LAZARUS_ENV=staging
LAZARUS_API_KEY=staging_api_key_change_me
LAZARUS_PORT=5555

# Security
ENCRYPTION_SALT=change_me_to_random_32_byte_hex_string

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# IPFS Storage
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
WEB3_STORAGE_TOKEN=your_web3_storage_token

# Redis
REDIS_URL=redis://redis:6379/0

# Database
DATABASE_PATH=/data/lazarus.db

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin_change_me

# Logging
LOG_LEVEL=INFO
LOG_PATH=/app/logs

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600
BACKUP_RETENTION_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# IPFS Configuration
IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
