# Production Environment Configuration
# Copy this file to .env.production and update with your production values
# NEVER commit actual production secrets to version control

# Application
LAZARUS_ENV=production
LAZARUS_API_KEY=your_production_api_key
LAZARUS_PORT=5555

# Security
ENCRYPTION_SALT=your_production_encryption_salt_32_bytes

# Email Service (SendGrid)
SENDGRID_API_KEY=your_production_sendgrid_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token

# IPFS Storage
PINATA_API_KEY=your_production_pinata_api_key
PINATA_SECRET_KEY=your_production_pinata_secret_key
WEB3_STORAGE_TOKEN=your_production_web3_storage_token

# Redis
REDIS_URL=redis://redis:6379/0

# Database
DATABASE_PATH=/data/lazarus.db

# Monitoring
GRAFANA_ADMIN_PASSWORD=your_strong_grafana_password

# Logging
LOG_LEVEL=WARNING
LOG_PATH=/app/logs

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600
BACKUP_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=60

# IPFS Configuration
IPFS_API_URL=http://ipfs:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Domain Configuration
DOMAIN=lazarusprotocol.com
GRAFANA_DOMAIN=grafana.lazarusprotocol.com
PROMETHEUS_DOMAIN=prometheus.lazarusprotocol.com
